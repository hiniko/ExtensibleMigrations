#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

commit_msg_file="$1"
first_line=$(head -n1 "$commit_msg_file")

# Allow merge / revert / fixup / squash autogenerated lines.
case "$first_line" in
  "Merge "*|"Revert "*|"fixup! "*|"squash! "*|"amend! "*) exit 0 ;;
esac

pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._/-]+\))?!?: .+'

if ! printf '%s' "$first_line" | grep -Eq "$pattern"; then
  echo "✗ Commit message does not follow Conventional Commits."
  echo ""
  echo "  Expected: <type>(<scope>)?: <description>"
  echo "  Types:    feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert"
  echo "  Examples: feat(api): add explicit DI extensions"
  echo "            fix!: drop deprecated CustomMigrationOperationAttribute"
  echo ""
  echo "  Got: $first_line"
  exit 1
fi
